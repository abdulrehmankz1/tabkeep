#!/bin/sh
# Blocks commits that mention AI tooling in the message. See .github/COMMIT_GUIDELINES.md

msg_file="$1"

if grep -iqE "claude|anthropic|co-authored-by|generated with|generated by|chatgpt|openai|copilot|gpt-[0-9]|ai-generated|ai generated" "$msg_file"; then
  echo "Commit rejected: message must not reference AI tools (see .github/COMMIT_GUIDELINES.md)." >&2
  exit 1
fi
